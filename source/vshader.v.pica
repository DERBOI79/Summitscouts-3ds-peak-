; Summit Scouts vertex shader: transform + per-vertex colour with distance fog.

.fvec projection[4], modelView[4]
.fvec fogp      ; x = 1/(far-near), y = -near/(far-near)
.fvec fogc      ; fog colour
.fvec tint      ; rgb = colour multiplier (weather + time of day), w = 1

.constf myconst(0.0, 1.0, -1.0, 0.0)
.alias zeros myconst.xxxx
.alias ones  myconst.yyyy

.out outpos position
.out outclr color

.in inpos v0
.in inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; fog factor = clamp(depth * fogp.x + fogp.y, 0, 1), depth = -view z
	mul r2, fogp.xxxx, -r1.zzzz
	add r2, fogp.yyyy, r2
	max r2, zeros, r2
	min r2, ones, r2

	; colour = mix(inclr * tint, fogc, factor)
	mul r3, inclr, tint
	add r4, fogc, -r3
	mul r4, r4, r2
	add outclr, r3, r4

	end
.end
